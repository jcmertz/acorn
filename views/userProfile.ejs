<!DOCTYPE html>
<html lang='en'>
<head>
    <meta charset='utf-8' />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://ajax.googleapis.com/ajax/libs/jqueryui/1.14.0/jquery-ui.min.js"></script>
    <script src='https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/index.global.min.js'></script>
    <link rel="stylesheet" href="../../styles/styles.css"/>
</head>
<body class="p-2">
    <%- include('partials/alerts') %>
    <div class="row mb-4">
        <div class="col d-flex justify-content-start">
            <a class="btn btn-primary" href="javascript:history.back()"><h4>BACK</h4></a>
        </div>
        <div class="col d-flex justify-content-center">
            <a href="/"><img src="../../AcornAppLogo.svg" style="height: 100%;" class="mb-3"></a>
        </div>
        <div class="col d-flex justify-content-end">
            <a class="btn btn-primary" href="/logout"><h4>LOGOUT</h4></a>
        </div>
    </div>
    
    <div class="row">
        <!-- Left Column: Band Details -->
        <div class="col-md-6 mb-4">
            <div class="card">
                <div class="card-body">
                    <h1 class="card-title">User Details</h1>
                    <form id="bandDetailsForm" action="/band/update" method="post">
                        <div class="mb-3">
                            <label for="bandName" class="form-label">User Name:</label>
                            <input type="text" class="form-control" id="bandName" name="bandName" value="<%= user.userName %>">
                        </div>
                        <div class="mb-3">
                            <label for="contactEmail" class="form-label">Email:</label>
                            <input type="email" class="form-control" id="email" name="email" value="<%= user.email %>">
                        </div>
                        <button type="submit" class="btn btn-success">Save Changes</button>
                    </form>
                </div>
            </div>
            <div class="card">
                <div class="card-body">
                    <h1 class="card-title">My Bands</h1>
                    <ul class="list-group">
                        <% user.bands.forEach(function(band) { %>
                            <li class="list-group-item">
                                <h5><%= band.bandName %></h5>
                            </li>
                        <% }); %>
                    </ul>
                    <!-- Button trigger modal -->
                    <button type="button" class="btn btn-primary mt-3" data-bs-toggle="modal" data-bs-target="#bandModal">
                        Add or Join a Band
                    </button>

                    <!-- Modal -->
                    <div class="modal fade" id="bandModal" tabindex="-1" aria-labelledby="bandModalLabel" aria-hidden="true">
                        <div class="modal-dialog">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h5 class="modal-title" id="bandModalLabel">Add a Band</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <div class="modal-body">
                                    <!-- Nav tabs -->
                                    <ul class="nav nav-tabs" id="bandTab" role="tablist">
                                        <li class="nav-item" role="presentation">
                                            <button class="nav-link active" id="create-tab" data-bs-toggle="tab" data-bs-target="#create" type="button" role="tab" aria-controls="create" aria-selected="true">Create New Band</button>
                                        </li>
                                        <li class="nav-item" role="presentation">
                                            <button class="nav-link" id="join-tab" data-bs-toggle="tab" data-bs-target="#join" type="button" role="tab" aria-controls="join" aria-selected="false">Join a Band</button>
                                        </li>
                                    </ul>
                                    <!-- Tab panes -->
                                    <div class="tab-content">
                                        <div class="tab-pane fade show active" id="create" role="tabpanel" aria-labelledby="create-tab">
                                            <form id="createBandForm" action="/band/create" method="post">
                                                <div class="mb-3">
                                                    <label for="newBandName" class="form-label">Band Name:</label>
                                                    <input type="text" class="form-control" id="newBandName" name="newBandName">
                                                </div>
                                                <div class="mb-3">
                                                    <label for="instagramHandle" class="form-label">Instagram Handle:</label>
                                                    <input type="text" class="form-control" id="instagramHandle" name="instagramHandle">
                                                </div>
                                                <button type="submit" class="btn btn-success">Create Band</button>
                                            </form>
                                        </div>
                                        <div class="tab-pane fade" id="join" role="tabpanel" aria-labelledby="join-tab">
                                            <p> Want to join an existing that is already on acorn? Ask your band mates to invite you!" </p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
    </body>
    </html>
    