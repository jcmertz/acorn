<!DOCTYPE html>
<html lang='en'>
<head>
    <meta charset='utf-8' />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://ajax.googleapis.com/ajax/libs/jqueryui/1.14.0/jquery-ui.min.js"></script>
    <script src='https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/index.global.min.js'></script>
    <link rel="stylesheet" href="../../styles/styles.css"/>
</head>
<body class="p-2">
    <%- include('partials/alerts') %>
    <%- include('partials/nav') %> <!-- Include the navigation bar -->
    
    <div class="row">
        <!-- Left Column: Band Details -->
        <div class="col-md-6 mb-4">
            <div class="card">
                <div class="card-body">
                    <h1 class="card-title">Band Details</h1>
                    <form id="bandDetailsForm" action="/band/<%=band._id%>/update" method="post">
                        <div class="mb-3">
                            <label for="bandName" class="form-label">Band Name:</label>
                            <input type="text" class="form-control" id="bandName" name="bandName" value="<%= band.bandName %>">
                        </div>
                        <div class="mb-3">
                            <label for="instagram" class="form-label">Instagram:</label>
                            <input type="text" class="form-control" id="instagram" name="instagram" value="<%= band.instagram %>">
                        </div>
                        <div class="mb-3">
                            <label for="genre" class="form-label">Genre:</label>
                            <input type="text" class="form-control" id="genre" name="genre" value="<%= band.genre %>">
                        </div>
                        <div class="mb-3">
                            <label for="homeTown" class="form-label">Hometown:</label>
                            <input type="text" class="form-control" id="homeTown" name="homeTown" value="<%= band.homeTown %>">
                        </div>
                        <button type="submit" class="btn btn-success">Save Changes</button>
                    </form>
                </div>
            </div>
            <div class="card">
                <div class="card-body">
                    <h1 class="card-title">Band Members</h1>
                    <%console.log(band);%>
                    <% band.bandMembers.forEach(function(member) { %>
                        <div class="card mb-2">
                            <div class="card-body d-flex align-items-center justify-content-between">
                                <a href="mailto:<%= member.email %>" class="text-decoration-none text-reset flex-grow-1">
                                    <!-- Profile Picture -->
                                    <img src="<%= member.profilePicture %>" 
                                    alt="Profile Picture" 
                                    class="img-thumbnail me-3" 
                                    style="width: 50px; height: 50px; object-fit: cover;">
                                    
                                    <!-- Name and Email -->
                                    <div>
                                        <h5 class="card-title mb-1">
                                            <%= member.firstName ? (member.firstName + ' ' + member.lastName + (member.pronouns ? " (" + member.pronouns + ")" : "")) : (member.user + (member.pronouns ? " (" + member.pronouns + ")" : "")) %>
                                        </h5>
                                        <p class="card-text mb-0"><%= member.email %></p>
                                    </div>
                                </a>
                                <!-- Delete Button -->
                                <form action="/band/<%=band._id%>/removeMember" method="post" class="ms-3">
                                    <input type="hidden" name="memberEmail" value="<%= member.email %>">
                                    <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Are you sure you want to remove this member?')">
                                        Remove
                                    </button>
                                </form>
                            </div>
                        </div>
                    <% }); %>
                    <!-- Button to Open the Modal -->
                    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addMemberModal">
                        Add Band Member
                    </button>

                    <!-- The Modal -->
                    <div class="modal fade" id="addMemberModal" tabindex="-1" aria-labelledby="addMemberModalLabel" aria-hidden="true">
                        <div class="modal-dialog">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h5 class="modal-title" id="addMemberModalLabel">Add Band Member</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <div class="modal-body">
                                    <form id="addMemberForm" action="/band/<%=band._id%>/addMember" method="post">
                                        <div class="mb-3">
                                            <label for="memberEmail" class="form-label">Email address:</label>
                                            <input type="email" class="form-control" id="memberEmail" name="memberEmail" required>
                                        </div>
                                        <button type="submit" class="btn btn-success">Send Invite</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Right Column: Show Calendar -->
        <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                    <h2>Upcoming Shows</h2>
                    <div id="upcomingShows"></div>
                </div>
            </div>
        </div>
    </div>
        
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var calendarEl = document.getElementById('upcomingShows');
            var calendar = new FullCalendar.Calendar(calendarEl, {
                initialView: 'listYear',
                timeZone: 'America/Chicago',
                events: {
                    url: '/events/getRange',
                    extraParams: {
                        band: '<%=band.bandName%>'
                    },
                    failure: function() {
                        alert('there was an error while fetching events!');
                    }
                },
                headerToolbar: {
                    left: '',
                    center: 'title',
                    right: 'prev,next'
                }
            });
            calendar.render();
        });
    </script>
    
</body>
</html>
    