<!DOCTYPE html>
<html lang='en'>

<head>
    <meta charset='utf-8' />
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://ajax.googleapis.com/ajax/libs/jqueryui/1.14.0/jquery-ui.min.js"></script>
    <link rel="stylesheet" href="../../../styles/styles.css"/>
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    
</head>

<body class="bg-light">
    <div class="container my-5">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <h1 class="text-center mb-4">New Event Request</h1>
                        <p class="mb-4">New Event Request For: <strong><%= userName %></strong> on <strong><%= month %>/<%= day %>/<%= year %></strong></p>
                        <form action="/addEvent" id="newmEventForm" method="post">
                            <input type="hidden" id="bandCount" name="bandCount" value="0">
                            
                            <div class="mb-3">
                                <button type="button" class="btn btn-outline-primary addBand w-100" id="addBandButton">Add Band</button>
                            </div>
                            
                            <input type="hidden" name="showDate" value="<%= month %>/<%= day %>/<%= year %>"/>
                            <input id="reqDate" type="hidden" name="reqDate"/>
                            
                            <div class="d-grid">
                                <button type="submit" class="btn btn-primary" id="submitButton" disabled>Submit Event Request</button>
                            </div>
                        </form>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
</div>

<%- include('partials/newBandsModule') %>
<%- include('partials/bandList') %>

<script>
    var date = new Date().toLocaleDateString();
    document.getElementById("reqDate").setAttribute("value", date);
    
    // Ensure the addBandtoForm function is properly defined
    $(document).ready(function() {
        // Make sure the Add Band button works
        $('#addBandButton').on('click', function() {
            console.log('Add Band button clicked');
            if (typeof window.addBandtoForm === 'function') {
                window.addBandtoForm();
            } else {
                console.error('addBandtoForm function is not defined');
                // Fallback implementation
                let bandCount = parseInt($('#bandCount').val()) || 0;
                
                // Create a div to hold the new band input and the remove button
                let div = document.createElement("div");
                div.classList.add("d-flex", "align-items-center", "my-2");
                div.setAttribute("id", "div" + bandCount);
                
                let newBand = document.createElement("input");
                newBand.setAttribute("type", "text");
                newBand.setAttribute("id", "band" + bandCount);
                newBand.setAttribute("name", "bands[" + bandCount+"][name]");
                newBand.setAttribute("list", "knownBands");
                newBand.setAttribute("autocomplete", "off");
                newBand.classList.add("form-control", "me-2");
                
                let validationIcon = document.createElement("span");
                validationIcon.setAttribute("id", "validationIcon" + bandCount);
                validationIcon.classList.add("validation-box", "me-2");
                
                let bandX = document.createElement("button");
                bandX.setAttribute("type", "button");
                bandX.textContent = "X";
                bandX.setAttribute("id", "otherBandX" + bandCount);
                bandX.classList.add("btn", "btn-danger");
                
                bandX.addEventListener('click', function() {
                    $('#div' + bandCount).remove();
                    let count = parseInt($('#bandCount').val());
                    count--;
                    $('#bandCount').val(count);
                });
                
                div.appendChild(newBand);
                div.appendChild(validationIcon);
                div.appendChild(bandX);
                
                $('#addBandButton').before(div);
                
                bandCount++;
                $('#bandCount').val(bandCount);
            }
        });
    });
</script>
</body>

</html>
