<!DOCTYPE html>
<html lang='en'>

<head>
    <meta charset='utf-8' />
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://ajax.googleapis.com/ajax/libs/jqueryui/1.14.0/jquery-ui.min.js"></script>
    <link rel="stylesheet" href="../../../styles/styles.css"/> 
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    <!-- Flatpickr -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/themes/material_blue.css">
    
    
</head>

<body class="bg-secondary">
    <%- include('partials/alerts') %>
    <%- include('partials/nav') %> <!-- Include the navigation bar -->  
    <div class="container my-5 d-flex justify-content-center">
        <div id="formContainer" class="d-flex flex-column">
            
            <button id="closeButton" class="btn-close position-relative"></button>
            
            <!-- Confirmation Modal -->
            <div class="modal fade" id="closeConfirmationModal" tabindex="-1" aria-labelledby="closeConfirmationModalLabel" aria-hidden="true">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="closeConfirmationModalLabel">Confirm Close</h5>
                            <button type="button" class="btn-close" data-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <p>Are you sure you want to abandon all progress and close the form?</p>
                            <p>This action cannot be undone.</p>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                            <a href="/" class="btn btn-danger">Yes, Close</a>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Step Progress Bar -->
            <div id="stepLabel" class="text-center text-muted small mb-1">
                Step 1 of 8
            </div>
            <div class="progress mb-4" style="height: 1.5rem;">
                <div id="progressBar" 
                class="progress-bar progress-bar-striped progress-bar-animated bg-primary" 
                role="progressbar" 
                style="width: 0%;" 
                aria-valuenow="0" 
                aria-valuemin="0" 
                aria-valuemax="100">
            </div>
        </div>
        
        <!-- Step 1: Introduction -->
        <div class="step" id="step-intro">
            <h2>Welcome to the Event Request Form!</h2>
            <br>
            <p>We’ll guide you step by step to make your event submission easy and clear.</p>
            <p> Click "Start" to begin.</p>
            <button class="btn btn-primary" onclick="nextStep()">Start</button>
        </div>
        
        <!-- Step 2: Confirm Date -->
        <div class="step d-none" id="step-date">
            <h2>Confirm Event Date</h2>            
            <input 
            id="datePicker" 
            class="form-control w-auto mb-3" 
            style="cursor:pointer;" 
            readonly />
            
            <small class="text-muted">Click the date above to change it.</small>
            <br>
            <button class="btn btn-secondary mt-3" onclick="prevStep()">Previous</button>
            <button class="btn btn-primary mt-3" onclick="nextStep()">Next</button>
            
        </div>
        
        <!-- Step 3: Add Bands -->
        <div class="step d-none" id="step-bands">
            <div class="position-relative">
                <h2>Add Bands</h2>
                <div id="bandsList" class="my-3"></div>
                <button type="button" id="addBandBtn" class="btn btn-outline-primary addBand w-100" onClick="addBandtoForm();">Add Band</button>
            </div>
            <button class="btn btn-secondary mt-3" onclick="prevStep()">Previous</button>
            <span id="step3NextWrapper">
                <button 
                id="step3NextBtn"
                class="btn btn-primary mt-3"
                onclick="nextStep()"
                disabled>
                Next
            </button>
        </span>
    </div>
    
    <!-- Step 4: Event Time -->
    <div class="step d-none" id="step-time">
        <h2>Event Time</h2>
        <p>Our regular show schedule is shown below, but feel free to request a different time!</p>
        
        <ul class="list-group">
            <li class="list-group-item d-flex justify-content-between align-items-center">
                <label for="showTimeDropdown" class="form-label fw-semibold mb-0">Show Time:</label>
                <div class="dropdown">
                    <button
                    class="btn btn-outline-primary dropdown-toggle"
                    type="button"
                    id="showTimeDropdown"
                    data-bs-toggle="dropdown"
                    aria-expanded="false"
                    >
                    8:00 PM
                </button>
                <ul class="dropdown-menu" aria-labelledby="showTimeDropdown" id="timeDropdownMenu"></ul>
            </div>
        </li>
        <li class="list-group-item d-flex justify-content-between align-items-center">
            <span>Doors</span>
            <span id="doorsTime">7:00 PM</span>
        </li>
        <li class="list-group-item d-flex justify-content-between align-items-center">
            <span>Sound Check</span>
            <span id="soundCheckTime">6:00 PM</span>
        </li>
        <li class="list-group-item d-flex justify-content-between align-items-center">
            <span>Load-in</span>
            <span id="loadInTime">5:00 PM</span>
        </li>
    </ul>
    
    <input type="hidden" id="eventTime" value="20:00"> <!-- Store selected time as HH:MM -->
    
    <button class="btn btn-secondary mt-3" onclick="prevStep()">Previous</button>
    <button class="btn btn-primary mt-3" onclick="nextStep()">Next</button>
</div>


<!-- Step 5: Cover Charge -->
<div class="step d-none" id="step-cover">
    <h2>Cover Charge</h2>
    <p>Our typical cover charge is <strong>$8–$15</strong>. Use the slider below to propose a cover charge.</p>
    
    <label for="coverChargeRange" class="form-label">
        Proposed Cover Charge:
        <span id="coverChargeLabel" class="fw-bold" role="textbox" contenteditable="true" style="cursor: text;" aria-label="Editable cover charge">$10</span>
    </label>
    
    <div class="position-relative">
        <!-- Highlighted range -->
        <div class="range-highlight bg-success"></div>
        
        <!-- The range input -->
        <input
        type="range"
        class="form-range"
        min="5"
        max="25"
        step="1"
        value="10"
        id="coverChargeRange"
        />
    </div>
    
    <!-- Key -->
    <div class="d-flex justify-content-between small text-muted mt-2" style="font-size: 0.75rem;">
        <span>$5</span>
        <span>$10</span>
        <span>$15</span>
        <span>$20</span>
        <span>$25</span>
    </div>
    <br>
    <small> Normal Payout is 70% to the Bands / 30% to the House </small>
    <br>
    <input type="hidden" id="coverCharge" name="coverCharge" value="10" />
    <button class="btn btn-secondary mt-3" onclick="prevStep()">Previous</button>
    <button class="btn btn-primary mt-3" onclick="nextStep()">Next</button>
    
</div>


<!-- Step 6: Additional Details -->
<div class="step d-none" id="step-details">
    <h2>Additional Details</h2>
    <textarea id="additionalDetails" name="additionalDetails" rows="5" class="form-control" placeholder="Tell us anything else about your event!"></textarea>
    <button class="btn btn-secondary mt-3" onclick="prevStep()">Previous</button>
    <button class="btn btn-primary mt-3" onclick="nextStep()">Next</button>
</div>

<!-- Step 7: Venue Terms -->
<div class="step d-none" id="step-terms">
    <h2>Venue Terms</h2>    
    <!-- Embedded PDF -->
    <div class="mb-3">
        <iframe src="../../../terms.pdf" width="100%" height="400px" style="border: none;">
            Your browser does not support embedded PDFs. Please download and review the terms and conditions instead.
        </iframe>
    </div>
    
    <!-- Download Button -->
    <a href="../../../terms.pdf" download class="btn btn-outline-primary mb-3">
        Download Terms and Conditions
    </a>
    <br>
    <label>
        <input type="checkbox" id="agreeTerms" required> I agree to follow all venue terms and conditions.
    </label>
    <br>
    <button class="btn btn-secondary mt-3" onclick="prevStep()">Previous</button>
    <button class="btn btn-primary mt-3" onclick="nextStep()">Next</button>
</div>


<!-- Step 8: Confirmation -->
<div class="step d-none" id="step-confirmation">
    <h2 class="text-center mb-4">Confirm Your Submission</h2>
    <p class="text-center mb-4">Please review the details of your event request before submitting.</p>
    
    <div class="row row-cols-1 row-cols-md-2 g-4">
        <!-- Confirmation Cards -->
        <div class="col">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Event Date</h5>
                    <p class="card-text" id="confirmDate"></p>
                </div>
            </div>
        </div>
        
        <div class="col">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Bands</h5>
                    <p class="card-text" id="confirmBands"></p>
                </div>
            </div>
        </div>
        
        <div class="col">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Event Time</h5>
                    <p class="card-text" id="confirmTime"></p>
                </div>
            </div>
        </div>
        
        <div class="col">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Cover Charge</h5>
                    <p class="card-text" id="confirmCover"></p>
                </div>
            </div>
        </div>
        
        <div class="col">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Additional Details</h5>
                    <p class="card-text" id="confirmDetails"></p>
                </div>
            </div>
        </div>
    </div>
    
    <div class="d-flex justify-content-between mt-4">
        <button class="btn btn-secondary" onclick="prevStep()">Previous</button>
        <button class="btn btn-success" onclick="submitForm()">Submit</button>
    </div>
</div>


<!-- Includes -->
<%- include('partials/newBandsModule') %>
<%- include('partials/bandList') %>
<script>
    const knownBands = <%- JSON.stringify(knownBandData) %>;
    const defaultDate = '<%= year %>-<%= month %>-<%= day %>'; // Format: YYYY-MM-DD
    
</script>


<script>
    let currentStep = 0;
    const steps = document.querySelectorAll('.step');
    updateProgressBar();
    
    function nextStep() {
        // Collect data from the current step
        if (currentStep === 1) {
            const selectedDate = document.getElementById('datePicker').value;
            document.getElementById('confirmDate').innerText = selectedDate;
        } else if (currentStep === 2) {
            const bandInputs = document.querySelectorAll('#bandsList input[name^="bands"]');
            
            if (bandInputs.length === 0) {
                alert('Please add at least one band before continuing.');
                return;
            }
            
            const bands = [];
            bandInputs.forEach(input => {
                bands.push(input.value);
            });
            
            document.getElementById('confirmBands').innerText = bands.join(', ');
        } else if (currentStep === 3) {
            document.getElementById('confirmTime').innerText = document.getElementById('eventTime').value;
        } else if (currentStep === 4) {
            document.getElementById('confirmCover').innerText = document.getElementById('coverCharge').value;
        } else if (currentStep === 5) {
            document.getElementById('confirmDetails').innerText = document.getElementById('additionalDetails').value;
        }
        else if (currentStep === 6 && !document.getElementById('agreeTerms').checked) {
            alert('You must agree to the venue rules before continuing.');
            return;
        }
        
        // Move to the next step
        steps[currentStep].classList.add('d-none');
        currentStep++;
        steps[currentStep].classList.remove('d-none');
        updateProgressBar(); // 👈 Add this
    }
    
    function prevStep() {
        // Move to the previous step
        steps[currentStep].classList.add('d-none');
        currentStep--;
        steps[currentStep].classList.remove('d-none');
        updateProgressBar(); // 👈 Add this
        
    }
    
    function submitForm() {
        // Get the selected date from Flatpickr
        let selectedDate = document.querySelector('#datePicker')._flatpickr.selectedDates[0];
        
        // Check if the user hasn't selected a date (or the date is invalid)
        if (!selectedDate) {
            // If no date selected, use the default date
            selectedDate = new Date(defaultDate); // Use the default date from the server-side code
        }
        
        // Format the date into YYYY-MM-DD
        const formattedDate = selectedDate.toISOString().split('T')[0];
        
        const formData = {
            showDate: formattedDate,
            eventTime: document.getElementById('eventTime').value,
            coverCharge: document.getElementById('coverCharge').value,
            additionalDetails: document.getElementById('additionalDetails').value,
            bands: []
        };
        
        const bandInputs = document.querySelectorAll('#bandsList input[name^="bands"]');
        bandInputs.forEach(input => {
            const bandName = input.value;
            const bandEmail = input.dataset.email || null;
            formData.bands.push({ name: bandName, email: bandEmail });
        });
        
        // Send the form data to the server
        $.post('/addEvent', formData, function(response) {
            // Handle the response from the server
            console.log(response); // Debugging line
            if (response.success) {
                window.location.href = '/';
            } else {
                alert('Error: ' + response.message);
            }
        }).fail(function(jqXHR, textStatus, errorThrown) {
            // Handle errors
            console.error('Error:', textStatus, errorThrown);
            alert('An error occurred while submitting the form. Please try again.');
        });
    }
    
    
    function addBandtoForm() {
        const wrapper = document.createElement('div');
        wrapper.className = 'my-3';
        
        // Helper message (above input)
        const helper = document.createElement('div');
        helper.className = 'custom-band-helper mb-1 text-muted small';
        helper.innerText = 'Type to search for a band...';
        
        // 🔊 Add ARIA attributes for screen readers
        helper.setAttribute('role', 'status');
        helper.setAttribute('aria-live', 'polite');
        
        // Input
        const input = document.createElement('input');
        input.type = 'text';
        input.name = 'bands[]';
        input.className = 'form-control band-input';
        input.placeholder = 'Enter band name';
        
        // Remove button
        const removeBtn = document.createElement('button');
        removeBtn.className = 'btn btn-outline-danger mt-2';
        removeBtn.type = 'button';
        removeBtn.innerText = 'Remove';
        removeBtn.onclick = () => {
            wrapper.remove();
            
            const bandCount = document.querySelectorAll('#bandsList input[name^="bands"]').length;
            const nextBtn = document.getElementById('step3NextBtn');
            if (bandCount === 0) {
                nextBtn.disabled = true;
            }
        };        
        // Add elements to wrapper
        wrapper.appendChild(helper);
        wrapper.appendChild(input);
        wrapper.appendChild(removeBtn);
        document.getElementById('bandsList').appendChild(wrapper);
        
        // Enable autocomplete
        $(input).autocomplete({
            source: function (request, response) {
                const term = request.term.trim();
                let filtered = knownBands.filter(band =>
                band.toLowerCase().includes(term.toLowerCase())
                );
                
                // Add a "create new" option if not already in knownBands
                const exactMatch = knownBands.some(band =>
                band.toLowerCase() === term.toLowerCase()
                );
                
                if (term.length > 0 && !exactMatch) {
                    filtered.push({
                        label: `+ Add new band "${term}"`,
                        value: term,
                        isNew: true
                    });
                }
                
                // 🔊 Update helper text
                if (term.length === 0) {
                    helper.innerText = 'Type to search for a band...';
                } else if (filtered.length === 0 || (filtered.length === 1 && filtered[0].isNew)) {
                    helper.innerText = 'No results found.';
                } else {
                    const count = filtered.filter(item => !item.isNew).length;
                    helper.innerText = `${count} result${count !== 1 ? 's' : ''} found.`;
                }
                
                response(filtered);
            },
            minLength: 0,
            open: function () {
                $(".ui-autocomplete").css("width", $(input).outerWidth());
            },
            select: function (event, ui) {
                const selectedBand = ui.item.value;
                
                // Prevent empty values
                if (!selectedBand.trim()) return false;
                
                // Duplicate check
                const existingInput = Array.from(document.querySelectorAll('#bandsList input[type="hidden"][name="bands[]"]'))
                .find(input => input.value.toLowerCase() === selectedBand.toLowerCase());
                
                
                if (existingInput) {
                    const card = existingInput.closest('.card');
                    if (card) {
                        card.classList.add('border-info', 'bg-light', 'shake');
                        setTimeout(() => {
                            card.classList.remove('border-info', 'bg-light', 'shake');
                        }, 1000);
                    }
                    return false;
                }
                
                // Clear wrapper and rebuild as card
                wrapper.innerHTML = '';
                
                const card = document.createElement('div');
                card.className = 'card p-2 d-flex flex-row align-items-center justify-content-between';
                
                const bandName = document.createElement('span');
                bandName.innerText = selectedBand;
                
                const hiddenInput = document.createElement('input');
                hiddenInput.type = 'hidden';
                hiddenInput.name = 'bands[]';
                hiddenInput.value = selectedBand;
                
                const removeBtn = document.createElement('button');
                removeBtn.className = 'btn btn-sm btn-outline-danger ms-2';
                removeBtn.type = 'button';
                removeBtn.innerHTML = '&times;';
                removeBtn.onclick = () => wrapper.remove();
                
                card.appendChild(bandName);
                card.appendChild(hiddenInput);
                card.appendChild(removeBtn);
                
                wrapper.appendChild(card);
                
                // Enable "Next" button only when at least one band is selected
                const nextBtn = document.getElementById('step3NextBtn');
                const wrapperEl = document.getElementById('step3NextWrapper');
                
                const selectedCount = document.querySelectorAll('#bandsList input[type="hidden"][name="bands[]"]').length;
                
                if (selectedCount > 0) {
                    nextBtn.disabled = false;
                }
                
                return false; // Prevent jQuery UI from resetting the input
                
            }
            
        }).data("ui-autocomplete")._renderItem = function (ul, item) {
            const $li = $("<li>");
                
                // Special style for "Add new band"
                if (item.isNew) {
                    $li.append(`<div class="text-primary fw-semibold">${item.label}</div>`);
                } else {
                    $li.append(`<div>${item.label}</div>`);
                }
                
                return $li.appendTo(ul);
            };
            
        }
        
        function updateProgressBar() {
            const stepNumber = currentStep + 1;
            const totalSteps = steps.length;
            const progressPercent = (stepNumber / totalSteps) * 100;
            
            const bar = document.getElementById('progressBar');
            bar.style.width = `${progressPercent}%`;
            bar.setAttribute('aria-valuenow', progressPercent.toFixed(0));
            
            const label = document.getElementById('stepLabel');
            label.textContent = `Step ${stepNumber} of ${totalSteps}`;
        }
        
        
    </script>
    <script>
        
        document.addEventListener('DOMContentLoaded', function () {
            const dateInput = document.getElementById('datePicker');
            
            // Ensure defaultDate is a valid string, and pad the month and day if necessary
            let defaultDateString = defaultDate.trim();  // Trim any extra spaces
            
            // Split the defaultDate into year, month, and day
            let [year, month, day] = defaultDateString.split('-');
            
            // Zero-pad the month and day if needed
            month = month.padStart(2, '0');
            day = day.padStart(2, '0');
            
            // Rebuild the date string in the proper format
            defaultDateString = `${year}-${month}-${day}`;
            
            // Validate the formatted defaultDate
            const isValidDate = !isNaN(Date.parse(defaultDateString));
            
            if (!isValidDate) {
                console.error("Invalid defaultDate format: ", defaultDateString);
                return; // If the date is invalid, stop execution
            }
            console.log("Default date: ", defaultDateString);
            // Ensure defaultDate is passed as a valid Date object
            const formattedDefaultDate = new Date(defaultDateString+"T22:00"); // Ensure defaultDate is correctly parsed
            console.log("Formatted date: ", formattedDefaultDate);
            // Remove readonly temporarily for mobile and desktop compatibility
            dateInput.removeAttribute('readonly');
            
            // Set the value directly for mobile browsers (iOS, Android)
            if (/Mobi|Android/i.test(navigator.userAgent)) {
                
                // Format the date in the desired format for mobile (e.g., "April 2, 2025")
                const formattedMobileDate = formattedDefaultDate.toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric'
                });
                
                // Set the formatted date for mobile
                dateInput.value = formattedMobileDate;
                document.getElementById('confirmDate').innerText = formattedMobileDate;  // Update confirmation text
            } else {
                // Initialize flatpickr for non-mobile (desktop browsers)
                const picker = flatpickr(dateInput, {
                    defaultDate: formattedDefaultDate,          // Initialize Flatpickr with the correctly formatted Date object
                    minDate: "today",                          // Prevent selecting past dates
                    disable: [
                    function(date) {
                        return date.getDay() === 1; // Disable Mondays
                    }
                    ],
                    dateFormat: "F j, Y",                      // Format displayed to user
                    allowInput: false,                         // Disable manual input
                    onChange: function(selectedDates, dateStr) {
                        document.getElementById('confirmDate').innerText = dateStr;
                    }
                });
            }
            
            // Reapply the readonly attribute after value is set
            dateInput.setAttribute('readonly', 'readonly');
            
            const addBtn = document.getElementById('addBandBtn');
            const nextBtnWrapper = document.getElementById('step3NextWrapper');
            const nextBtn = document.getElementById('step3NextBtn');
            
            // Shake Add Band button on click of disabled Next
            nextBtnWrapper.addEventListener('mouseenter', () => {
                if (nextBtn.disabled) {
                    addBtn.classList.add('shake');
                    
                    setTimeout(() => {
                        addBtn.classList.remove('shake');
                    }, 400);
                }
            });
            
        });
        
        
    </script>
    <script>
        function formatTimeString(hours, minutes) {
            const date = new Date();
            date.setHours(hours, minutes);
            return date.toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' });
        }
        
        function updateRelativeTimesFromValue(timeValue) {
            const [hour, minute] = timeValue.split(':').map(Number);
            const getRelativeTime = offset => formatTimeString(hour - offset, minute);
            
            document.getElementById('doorsTime').innerText = getRelativeTime(1);
            document.getElementById('soundCheckTime').innerText = getRelativeTime(2);
            document.getElementById('loadInTime').innerText = getRelativeTime(3);
        }
        
        document.addEventListener('DOMContentLoaded', () => {
            const dropdown = document.getElementById('timeDropdownMenu');
            const displayBtn = document.getElementById('showTimeDropdown');
            const hiddenInput = document.getElementById('eventTime');
            
            // Create 30-min increment options from 3:00 PM to 10:00 PM
            for (let hour = 15; hour <= 22; hour++) {
                for (let min of [0, 30]) {
                    if (hour === 22 && min > 0) continue; // Skip 10:30 PM
                    const value = `${String(hour).padStart(2, '0')}:${String(min).padStart(2, '0')}`;
                    const label = formatTimeString(hour, min);
                    const item = document.createElement('li');
                    item.innerHTML = `<a class="dropdown-item" href="#" data-time="${value}">${label}</a>`;
                    dropdown.appendChild(item);
                }
            }
            
            dropdown.addEventListener('click', (e) => {
                const time = e.target.getAttribute('data-time');
                if (!time) return;
                
                hiddenInput.value = time;
                displayBtn.innerText = e.target.innerText;
                updateRelativeTimesFromValue(time);
            });
            
            // Initialize relative times
            updateRelativeTimesFromValue(hiddenInput.value);
        });
    </script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const range = document.getElementById('coverChargeRange');
            const label = document.getElementById('coverChargeLabel');
            const hidden = document.getElementById('coverCharge');
            
            range.addEventListener('input', () => {
                label.textContent = `$${range.value}`;
                hidden.value = range.value;
            });
        });
    </script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const range = document.getElementById('coverChargeRange');
            const label = document.getElementById('coverChargeLabel');
            const hidden = document.getElementById('coverCharge');
            
            const MIN = parseInt(range.min);
            const MAX = parseInt(range.max);
            
            // Update label and hidden field when slider changes
            range.addEventListener('input', () => {
                label.textContent = `$${range.value}`;
                hidden.value = range.value;
            });
            
            // Update slider when user edits the label
            label.addEventListener('blur', () => {
                let val = label.textContent.replace(/[^\d]/g, ''); // Strip non-numeric
                if (!val) return; // empty? bail
                val = parseInt(val);
                
                label.textContent = `$${val}`;
                hidden.value = val;
                
                if (val < MIN) {
                    range.value = MIN;
                } else if (val > MAX) {
                    range.value = MAX;
                } else {
                    range.value = val;
                }
            });
            
            // Optional: Pressing Enter while editing label also commits change
            label.addEventListener('keydown', (e) => {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    label.blur(); // triggers blur handler above
                }
            });
        });
    </script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Handle the close button click event
            document.getElementById('closeButton').addEventListener('click', function() {
                if (currentStep > 0) {
                    // Show confirmation modal if the user is past Step 1
                    new bootstrap.Modal(document.getElementById('closeConfirmationModal')).show();
                } else {
                    // If they're still on Step 1, just redirect to the home page
                    window.location.href = '/';
                }
            });
            
            // Listen for the ESC key press
            document.addEventListener('keydown', function(event) {
                if (event.key === 'Escape') { // If ESC key is pressed
                    // Trigger the close button click event
                    document.getElementById('closeButton').click();
                }
            });        });
        </script>
        
    </body>
    
    </html>
    