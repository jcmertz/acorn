<!DOCTYPE html>
<html lang='en'>
<head>
    <meta charset='utf-8' />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <link rel="stylesheet" href="../../styles/styles.css"/>
</head>
<body>
    <%- include('partials/alerts') %>
    <%- include('partials/nav') %>
    
<div class="container mt-4">
    <h1>Manage Bands</h1>
    
    <!-- Add New Band Form -->
    <div class="card mb-4">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">Add New Band</h5>
        </div>
        <div class="card-body">
            <form action="/bands/create" method="POST">
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label for="newBandName" class="form-label">Band Name</label>
                        <input type="text" class="form-control" id="newBandName" name="newBandName" required>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label for="instagramHandle" class="form-label">Instagram Handle</label>
                        <input type="text" class="form-control" id="instagramHandle" name="instagramHandle">
                    </div>
                    <div class="col-md-4 mb-3">
                        <label for="genre" class="form-label">Genre</label>
                        <input type="text" class="form-control" id="genre" name="genre">
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label for="homeTown" class="form-label">Home Town</label>
                        <input type="text" class="form-control" id="homeTown" name="homeTown">
                    </div>
                    <div class="col-md-8 d-flex align-items-end">
                        <button type="submit" class="btn btn-primary">Add Band</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
    
    <!-- Bands List -->
    <div class="card">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">All Bands</h5>
        </div>
        <div class="card-body">
            <% if (bands && bands.length > 0) { %>
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>Band Name</th>
                                <th>Instagram</th>
                                <th>Genre</th>
                                <th>Home Town</th>
                                <th>Members</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% bands.forEach(band => { %>
                                <tr>
                                    <td><a href="/band/<%= band._id %>"><%= band.bandName %></a></td>
                                    <td><%= band.instagram || '-' %></td>
                                    <td><%= band.genre || '-' %></td>
                                    <td><%= band.homeTown || '-' %></td>
                                    <td><%= band.bandMembers ? band.bandMembers.length : 0 %></td>
                                    <td>
                                        <div class="btn-group" role="group">
                                            <a href="/band/<%= band._id %>" class="btn btn-sm btn-info">View</a>
                                            <button type="button" class="btn btn-sm btn-danger" data-toggle="modal" data-target="#deleteBandModal<%= band._id %>">Delete</button>
                                        </div>
                                        
                                        <!-- Delete Confirmation Modal -->
                                        <div class="modal fade" id="deleteBandModal<%= band._id %>" tabindex="-1" aria-labelledby="deleteBandModalLabel<%= band._id %>" aria-hidden="true">
                                            <div class="modal-dialog">
                                                <div class="modal-content">
                                                    <div class="modal-header">
                                                        <h5 class="modal-title" id="deleteBandModalLabel<%= band._id %>">Confirm Delete</h5>
                                                        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                                            <span aria-hidden="true">&times;</span>
                                                        </button>
                                                    </div>
                                                    <div class="modal-body">
                                                        Are you sure you want to delete the band "<%= band.bandName %>"? This action cannot be undone.
                                                    </div>
                                                    <div class="modal-footer">
                                                        <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                                                        <form action="/bands/<%= band._id %>/delete" method="POST" style="display: inline;">
                                                            <button type="submit" class="btn btn-danger">Delete</button>
                                                        </form>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            <% } else { %>
                <div class="alert alert-info">No bands found. Add a band using the form above.</div>
            <% } %>
        </div>
    </div>
</div>

</body>
</html>