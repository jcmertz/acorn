<!DOCTYPE html>
<html lang='en'>
<head>
  <meta charset='utf-8' />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"> </script>
  <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
  <script src="https://ajax.googleapis.com/ajax/libs/jqueryui/1.14.0/jquery-ui.min.js"></script>
  <script src='https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/index.global.min.js'></script>
  <link rel="stylesheet" href="../../styles/styles.css"/>
</head>
<body class="p-2" onload="populateBandTable()">
  <%- include('partials/alerts') %>
  <div class="row mb-4">
    <div class="col d-flex justify-content-start">
      <a class="btn btn-primary" href="javascript:history.back()"><h4>BACK</h4></a>
    </div>
    <div class="col d-flex justify-content-center">
      <a href="/"><img src="../../AcornAppLogo.svg" style="height: 100%;" class="mb-3"></a>
    </div>
    <div class="col d-flex justify-content-end">
      <a class="btn btn-primary" href="/logout"><h4>LOGOUT</h4></a>
    </div>
  </div>
  
  <div class="row">
    <!-- Left Column: Show Details -->
    <div class="col-md-6 mb-4">
      <div class="card">
        <div class="card-body">
          <h1 class="card-title">Show Details</h1>
          <p class="card-text">Show Date: <strong><%= show.showDate ? show.showDate.toDateString() : '' %></strong></p>
          <p class="card-text">Show Name: <strong><%= show.showName || '' %></strong></p>
          <p class="card-text">Contact Band: <strong><%= show.contactBand ? show.contactBand.bandName : '' %></strong></p>
          <p class="card-text">Ticket Price: <strong><%= show.ticketPrice !== undefined ? '$' + show.ticketPrice.toFixed(2) : '' %></strong></p>
          <p class="card-text">Tickets Sold: <strong><%= show.ticketsSold !== undefined ? show.ticketsSold : '' %></strong></p>
          <% if (!isAdmin) { %>
  <p class="card-text">Show Status: <strong><%= show.showStatus !== undefined ? (show.showStatus === -1 ? 'Cancelled' : show.showStatus === 0 ? 'Submitted' : show.showStatus === 1 ? 'Date Held Pending Negotiation' : show.showStatus === 2 ? 'Confirmed' : '') : '' %></strong></p>
<% } %>


<% if (isAdmin) { %>
<div class="mb-3">
  <label for="showStatusSelect" class="form-label">Edit Show Status</label>
  <select id="showStatusSelect" class="form-select" onchange="updateShowStatus('<%= show._id %>', this.value)">
    <option value="-1" <%= show.showStatus === -1 ? 'selected' : '' %>>Cancelled</option>
    <option value="0" <%= show.showStatus === 0 ? 'selected' : '' %>>Submitted</option>
    <option value="1" <%= show.showStatus === 1 ? 'selected' : '' %>>Date Held Pending Negotiation</option>
    <option value="2" <%= show.showStatus === 2 ? 'selected' : '' %>>Confirmed</option>
  </select>
</div>
<% } %>
          
          <!-- New Section for Other Bands -->
<div class="card mt-4">
  <div class="card-body">
    <h2 class="card-title">Bands</h2>
    <% if (isAdmin || show.showStatus !== 2) { %>
      <form action="/shows/updateBands" method="post">
        <input type="hidden" id="bandCount" name="bandCount" value="1">
        <input type="hidden" name="showId" value="<%= show._id %>" />
        <!-- Dynamically Populate the Table -->

        <!-- Button to Add New Band -->
        <div class="mb-3">
          <button type="button" class="btn btn-outline-primary addBand w-100" onClick="addBandtoForm();">Add Band</button>
        </div>
        <button type="submit" id="submitButton" class="btn btn-success w-100">Save Changes</button>
      </form>
    <% } else { %>
      <div id="bandTable">
        <% show.bands.forEach(function(band) { %>
          <p><strong><%= band.bandName %></strong></p>
        <% }); %>
      </div>
    <% } %>
  </div>
</div>
        </div>
      </div>
    </div>
    
    <!-- Right Column: Messaging Tool -->
    <div class="col-md-6">
      <div class="card">
        <div class="card-body">
          <h1 class="card-title">Messages</h1>
          <%- include('partials/messages') %>
        </div>
      </div>
    </div>
  </div>
  <%- include('partials/newBandsModule') %>
  <%- include('partials/bandList') %>
  
  
  <script>
    // Function to set a new primary contact band
    function makePrimary(bandId) {
      $.post('/shows/setPrimaryBand', { showId: '<%= show._id %>', bandId: bandId }, function() {
        location.reload(); // Reload page after setting primary band
      });
    }
    
    function populateBandTable(){
      var bands = <%- JSON.stringify(show.bands) %>
      console.log(bands);
      bands.forEach((band,index) => {
        addBandtoForm(band.bandName);
      });
    }
    function updateShowStatus(showId, status) {
    $.post('/admin/setShowStatus', { id: showId, showStatus: status }, function() {
      location.reload();
    });
  }
  </script>
  
</body>
</html>
